NODE_ENV=development
PORT=3000
APP_ID=api
LOG_LEVEL=info
REQUEST_LIMIT=100kb

DATABASE_URL="postgresql://user:password@localhost:5432/ifa"

# JWT : obligatoires (16 caractères minimum), l'API refuse de démarrer sans
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

REDIS_URL=redis://localhost:6379
USE_REDIS_RATE_LIMIT=false
SKIP_DB=false

# E-mails (vérification de compte, mot de passe oublié)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="IFA Resto <no-reply@example.com>"
# Liens ouverts depuis les e-mails (deep links de l'appli client par défaut)
VERIFY_EMAIL_URL=ifaresto://verify-email
RESET_PASSWORD_URL=ifaresto://reset-password
